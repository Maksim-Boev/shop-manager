{
  "name": "shop-manager-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:manager": "pnpm --filter manager dev",
    "dev:cashier": "pnpm --filter cashier dev",
    "build": "pnpm --filter './apps/*' build",
    "lint": "pnpm --filter './apps/*' lint",
    "db:generate": "pnpm --filter @shop/db db:generate",
    "db:migrate": "pnpm --filter @shop/db db:migrate",
    "db:push": "pnpm --filter @shop/db db:push",
    "db:studio": "pnpm --filter @shop/db db:studio",
    "db:reset": "pnpm --filter @shop/db db:reset"
  }
}
